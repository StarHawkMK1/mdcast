# graft's cards are gitignored but should stay greppable: ripgrep reads
# .ignore before .gitignore, so this re-admits the tree to search only.
!graft/
graft/.cache/
graft/.graph/

# docs/ is gitignored (private repo) but should stay searchable; archive and decisions stay out.
!docs/
docs/workbench/archive/
docs/decisions/
